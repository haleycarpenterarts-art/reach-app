# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.example is the committed template.

# --- Database (Supabase Postgres) ---
# Copy both from Supabase → Project Settings → Database → Connection string.
# Use the POOLER hosts, not db.[PROJECT-REF].supabase.co — the direct host is
# IPv6-only on current projects and will not resolve from most machines.
# Note the username format: postgres.[PROJECT-REF], not plain postgres.
#
# Transaction pooler (:6543) — application runtime.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres"
# Session pooler (:5432) — migrations and pg_dump. Supports the long-running
# transactions and session state that the transaction pooler does not.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase (client + server) ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Legacy anon key (kept for libs that still expect this name)
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Server-only — full DB access. Do not expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# --- App ---
# Origin used for auth redirects (email confirmation, password reset).
# Local: http://localhost:3000. Deployed: the real origin.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Anthropic (AI: extraction, assistant, scope drafting) ---
ANTHROPIC_API_KEY=""

# --- Resend (transactional + customer-update email) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# --- Sentry (error tracking) ---
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
